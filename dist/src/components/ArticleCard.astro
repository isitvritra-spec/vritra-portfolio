---
interface Props {
  article: {
    slug: string;
    data: {
      title: string;
      excerpt: string;
      publishedDate: string;
      category: string;
      readTime?: string;
      image?: string;
    };
  };
  featured?: boolean;
}

const { article, featured = false } = Astro.props;
const { slug, data } = article;
---

<a
  href={`/articles/${slug}`}
  class:list={[
    "group block bg-black text-white rounded-lg overflow-hidden transition-all duration-300",
    "hover:bg-black/90 hover:shadow-2xl hover:scale-[1.02]",
    featured ? "md:col-span-2 md:flex md:flex-row" : "flex flex-col",
  ]}
>
  {
    data.image && (
      <div
        class:list={[
          "overflow-hidden bg-gray-900",
          featured ? "md:w-1/2 aspect-video md:aspect-auto" : "aspect-video",
        ]}
      >
        <img
          src={data.image}
          alt={data.title}
          loading="lazy"
          class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
        />
      </div>
    )
  }

  <div
    class:list={[
      "p-6 flex flex-col flex-1",
      featured && "md:w-1/2 md:justify-center md:p-8",
    ]}
  >
    {
      featured && (
        <span class="inline-block w-fit px-3 py-1 bg-white/20 text-white text-xs font-bold uppercase tracking-widest rounded mb-4">
          Featured
        </span>
      )
    }

    <div class="flex items-center gap-3 mb-4">
      <span
        class="inline-block px-3 py-1 bg-white/10 text-white/90 text-xs font-medium uppercase tracking-wider rounded"
      >
        {data.category}
      </span>
      <span class="text-xs text-white/50">
        {
          new Date(data.publishedDate).toLocaleDateString("en-US", {
            month: "short",
            day: "numeric",
            year: "numeric",
          })
        }
      </span>
    </div>

    <h3
      class:list={[
        "font-bold leading-tight mb-3 transition-colors group-hover:text-white/80",
        featured ? "text-2xl md:text-3xl" : "text-lg",
      ]}
    >
      {data.title}
    </h3>

    <p class="text-sm text-white/70 line-clamp-3 leading-relaxed flex-1 mb-4">
      {data.excerpt}
    </p>

    <div
      class="flex items-center justify-between pt-4 border-t border-white/10"
    >
      <span class="text-xs text-white/60">
        {data.readTime || "5"} min read
      </span>
      <span
        class="text-sm font-medium text-white/80 transition-all group-hover:text-white group-hover:translate-x-1"
      >
        Read more →
      </span>
    </div>
  </div>
</a>
