---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { getCollection } from "astro:content";

const allArticles = await getCollection("articles");
const sortedArticles = allArticles.sort(
  (a, b) =>
    new Date(b.data.publishedDate).getTime() -
    new Date(a.data.publishedDate).getTime(),
);

const categories = [...new Set(allArticles.map((a) => a.data.category))];
const featured = sortedArticles[0];
const rest = sortedArticles.slice(1);
---

<BaseLayout
  title="Articles"
  description="Read articles about .NET, AI, and the future of software development."
>
  <section class="min-h-screen py-32 bg-gradient-to-b from-white to-gray-50">
    <div class="max-w-7xl mx-auto px-6">
      <!-- Header with Decorative Element -->
      <header class="text-center mb-16 relative">
        <!-- Diagonal Lines Decorative Element - Top Right -->
        <div class="absolute right-0 -top-8 hidden md:block">
          <svg width="60" height="60" viewBox="0 0 60 60" fill="none">
            <line x1="10" y1="5" x2="50" y2="45" stroke="black" stroke-width="2"
            ></line>
            <line x1="20" y1="5" x2="60" y2="45" stroke="black" stroke-width="2"
            ></line>
            <line x1="0" y1="15" x2="40" y2="55" stroke="black" stroke-width="2"
            ></line>
            <line
              x1="10"
              y1="15"
              x2="50"
              y2="55"
              stroke="black"
              stroke-width="2"></line>
          </svg>
        </div>

        <h1
          class="text-5xl md:text-6xl font-bold mb-4 tracking-tight animate-fade-in"
        >
          LATEST ARTICLES
        </h1>
        <p
          class="text-base text-black/60 max-w-2xl mx-auto animate-fade-in"
          style="animation-delay: 0.1s;"
        >
          Insights, tutorials, and deep dives into modern software development,
          AI, and cloud architecture
        </p>
      </header>

      <!-- Category Navigation -->
      <nav
        class="flex flex-wrap gap-3 justify-center mb-12 animate-fade-in"
        style="animation-delay: 0.2s;"
      >
        <button
          class="cat-btn px-5 py-2.5 text-sm font-medium uppercase tracking-wider rounded-full border-2 bg-black text-white border-black transition-all duration-300 hover:bg-black/90 hover:-translate-y-0.5"
          data-category="all"
        >
          All
        </button>
        {
          categories.map((cat) => (
            <button
              class="cat-btn px-5 py-2.5 text-sm font-medium uppercase tracking-wider rounded-full border-2 border-black/10 text-black/70 bg-transparent transition-all duration-300 hover:border-black/30 hover:-translate-y-0.5"
              data-category={cat}
            >
              {cat}
            </button>
          ))
        }
      </nav>

      <!-- Featured Article -->
      {
        featured && (
          <div
            class="featured-wrapper mb-12 opacity-0"
            data-category={featured.data.category}
            style="animation: fadeInUp 0.8s ease-out 0.3s forwards;"
          >
            <ArticleCard article={featured} featured={true} />
          </div>
        )
      }

      <!-- Articles Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {
          rest.map((article, index) => (
            <div
              class="article-wrapper opacity-0"
              data-category={article.data.category}
              data-index={index}
              style={`animation: fadeInUp 0.8s ease-out ${0.4 + index * 0.1}s forwards;`}
            >
              <ArticleCard article={article} />
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .animate-fade-in {
    animation: fadeIn 0.8s ease-out forwards;
  }

  .featured-wrapper.hidden,
  .article-wrapper.hidden {
    display: none !important;
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>(".cat-btn");
  const featured = document.querySelector<HTMLDivElement>(".featured-wrapper");
  const wrappers =
    document.querySelectorAll<HTMLDivElement>(".article-wrapper");

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const category = btn.dataset.category;

      // Update button states
      buttons.forEach((b) => {
        b.classList.remove("bg-black", "text-white", "border-black");
        b.classList.add("border-black/10", "text-black/70", "bg-transparent");
      });
      btn.classList.remove(
        "border-black/10",
        "text-black/70",
        "bg-transparent",
      );
      btn.classList.add("bg-black", "text-white", "border-black");

      // Filter articles
      if (category === "all") {
        if (featured) featured.classList.remove("hidden");
        wrappers.forEach((w) => w.classList.remove("hidden"));
      } else {
        if (featured && featured.dataset.category) {
          featured.classList.toggle(
            "hidden",
            featured.dataset.category !== category,
          );
        }
        wrappers.forEach((w) => {
          if (w.dataset.category) {
            w.classList.toggle("hidden", w.dataset.category !== category);
          }
        });
      }
    });
  });
</script>
