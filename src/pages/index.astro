              </div>
            </div>
          </div>

          <!-- Description -->
          <p class="text-base text-black/70 max-w-xl leading-relaxed">
            {home.data.heroDescription}
          </p>

          <!-- Checkmark List -->
          <div class="space-y-2">
            {
              approach.map((item) => (
                <div class="flex items-start gap-3">
                  <svg
                    class="w-4 h-4 text-black mt-0.5 flex-shrink-0"
