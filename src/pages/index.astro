          </div>
        </div>
        <div class="relative hidden lg:block">
          <div class="relative mt-12">
            <div
              class="absolute bottom-40 -left-2 bg-black text-white w-35 h-35 rounded-full flex items-center justify-center text-3xl font-semibold shadow-2xl z-0"
            >
              <span class="relative">
                Hello
                <div
