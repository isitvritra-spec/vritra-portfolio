---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection, getEntry } from "astro:content";
import type { CollectionEntry } from "astro:content";

// Import components
import Hero from "../components/Hero.astro";
import StatsBar from "../components/StatsBar.astro";
import Services from "../components/Services.astro";
import Testimonials from "../components/Testimonials.astro";
import FeaturedProject from "../components/FeaturedProject.astro";
import AboutPreview from "../components/AboutPreview.astro";
import LatestArticles from "../components/LatestArticles.astro";

// Fetch homepage content from collection
const home = await getEntry("pages", "home");
if (!home) {
  throw new Error("Homepage content not found in collections");
}

// Explicitly type the data to help TypeScript
type HomeData = CollectionEntry<"pages">["data"];
const data: HomeData = home.data;

const { approach, currentProject, stats, services } = data;

// Fetch latest articles
const allArticles = await getCollection("articles");
const latestArticles = allArticles
  .sort(
    (a, b) =>
      new Date(b.data.publishedDate).getTime() -
      new Date(a.data.publishedDate).getTime(),
  )
  .slice(0, 3);
---

<BaseLayout title={home.data.title} description={home.data.description}>
  <Hero approach={approach} />

  <StatsBar />

  <Services services={services} />

  <Testimonials />

  <FeaturedProject currentProject={currentProject} />

  <AboutPreview stats={stats} />

  <LatestArticles latestArticles={latestArticles} />

  <!-- Animation Script -->
  <script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    import { initSmoothScroll } from "../utils/smooth-scroll";

    // Register plugins
    gsap.registerPlugin(ScrollTrigger);

    // Check for reduced motion preference
    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    // Initialize on DOM load
    document.addEventListener("DOMContentLoaded", () => {
      if (prefersReducedMotion) {
        // Significantly reduce animation complexity for users who prefer reduced motion
        gsap.globalTimeline.timeScale(20);
        return;
      }

      // Initialize smooth scroll
      initSmoothScroll();

      // ===== HERO SECTION ANIMATIONS =====

      console.log("🚀 Hero animations starting...");

      // Heading reveal
      gsap.from("h1", {
        y: 40,
        opacity: 0,
        duration: 0.8,
        ease: "power3.out",
        delay: 0.4,
        onComplete: () => console.log("✅ Heading animated"),
      });

      // Role line animation
      gsap.from(".hero-role-line", {
        width: 0,
        opacity: 0,
        duration: 1,
        ease: "power2.out",
        delay: 0.6,
        onComplete: () => console.log("✅ Role line animated"),
      });

      // Description fade in
      gsap.from(".heroDescription", {
        y: 30,
        opacity: 0,
        duration: 0.6,
        delay: 0.8,
      });

      // Approach cards stagger
      const cards = document.querySelectorAll(".approach-cards > div");
      console.log(`🎯 Found ${cards.length} approach cards`);
      gsap.fromTo(
        cards,
        {
          y: 30,
          opacity: 0,
          visibility: "hidden",
        },
        {
          y: 0,
          opacity: 1,
          visibility: "visible",
          duration: 0.5,
          stagger: 0.1,
          delay: 1,
          ease: "power2.out",
          onComplete: () => console.log("✅ Approach cards animated"),
        },
      );

      // CTA Buttons with magnetic effect
      const ctaButtons = document.querySelectorAll(".hero-ctas a");
      console.log(`🎯 Found ${ctaButtons.length} CTA buttons`);
      gsap.fromTo(
        ctaButtons,
        {
          y: 20,
          opacity: 0,
          visibility: "hidden",
        },
        {
          y: 0,
          opacity: 1,
          visibility: "visible",
          duration: 0.6,
          stagger: 0.15,
          delay: 1.2,
          ease: "back.out(1.5)",
          onComplete: () => console.log("✅ CTA buttons animated"),
        },
      );

      // Magnetic hover effect for buttons
      ctaButtons.forEach((button) => {
        const btn = button as HTMLElement;

        btn.addEventListener("mouseenter", () => {
          gsap.to(btn, {
            scale: 1.05,
            duration: 0.3,
            ease: "power2.out",
          });
        });

        btn.addEventListener("mousemove", (e: MouseEvent) => {
          const rect = btn.getBoundingClientRect();
          const x = e.clientX - rect.left - rect.width / 2;
          const y = e.clientY - rect.top - rect.height / 2;

          gsap.to(btn, {
            x: x * 0.2,
            y: y * 0.2,
            duration: 0.3,
            ease: "power2.out",
          });
        });

        btn.addEventListener("mouseleave", () => {
          gsap.to(btn, {
            x: 0,
            y: 0,
            scale: 1,
            duration: 0.5,
            ease: "elastic.out(1, 0.5)",
          });
        });
      });

      // Profile image section animations
      const profileSection = document.querySelector(
        ".relative.hidden.lg\\:block",
      );
      if (profileSection) {
        // Profile image fade in
        const profileImg = profileSection.querySelector("img");
        if (profileImg) {
          gsap.from(profileImg, {
            scale: 0.8,
            opacity: 0,
            duration: 1,
            ease: "power3.out",
            delay: 0.3,
          });
        }

        // SVG decoration entrance
        const svgDecoration = profileSection.querySelector(
          "svg.absolute.-top-12",
        );
        if (svgDecoration) {
          gsap.from(svgDecoration, {
            opacity: 0,
            duration: 0.8,
            ease: "power2.out",
            delay: 0.8,
          });
        }
      }

      // ===== SERVICES SECTION =====

      // Section header reveal
      gsap.from(".text-4xl.lg\\:text-6xl", {
        scrollTrigger: {
          trigger: ".text-4xl.lg\\:text-6xl",
          start: "top 80%",
        },
        y: 60,
        opacity: 0,
        duration: 0.8,
        ease: "power3.out",
      });

      // Service cards with 3D tilt effect
      const serviceCards = document.querySelectorAll(".grid.flex-1 > div");

      serviceCards.forEach((card) => {
        const cardEl = card as HTMLElement;
        let isHovering = false;

        cardEl.addEventListener("mouseenter", () => {
          isHovering = true;
          gsap.to(cardEl, {
            scale: 1.03,
            duration: 0.3,
            ease: "power2.out",
          });
        });

        cardEl.addEventListener("mousemove", (e: MouseEvent) => {
          if (!isHovering) return;

          const rect = cardEl.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;

          const centerX = rect.width / 2;
          const centerY = rect.height / 2;

          const rotateX = ((y - centerY) / centerY) * -8;
          const rotateY = ((x - centerX) / centerX) * 8;

          gsap.to(cardEl, {
            rotationX: rotateX,
            rotationY: rotateY,
            transformPerspective: 1000,
            duration: 0.3,
            ease: "power2.out",
          });
        });

        cardEl.addEventListener("mouseleave", () => {
          isHovering = false;
          gsap.to(cardEl, {
            scale: 1,
            rotationX: 0,
            rotationY: 0,
            transformPerspective: 1000,
            duration: 0.4,
            ease: "power2.out",
          });
        });
      });

      // ===== CURRENT PROJECT SECTION =====

      // Diagonal lines draw animation
      const diagonalLines = document.querySelectorAll(
        ".absolute.inset-0.opacity-5",
      );
      gsap.from(diagonalLines, {
        scrollTrigger: {
          trigger: "#current-work",
          start: "top 75%",
        },
        opacity: 0,
        duration: 0.6,
        ease: "power2.out",
      });

      // Project card slide in
      const projectCard = document.querySelector(".relative.group");
      if (projectCard) {
        gsap.from(projectCard, {
          scrollTrigger: {
            trigger: projectCard,
            start: "top 80%",
          },
          y: 40,
          opacity: 0,
          duration: 0.6,
          ease: "power3.out",
        });

        // Technology tags stagger
        const techTags = projectCard.querySelectorAll(
          ".flex.flex-wrap.gap-2 > span",
        );
        gsap.from(techTags, {
          scrollTrigger: {
            trigger: projectCard,
            start: "top 70%",
          },
          scale: 0,
          opacity: 0,
          duration: 0.4,
          stagger: 0.05,
          ease: "back.out(1.7)",
        });
      }

      // ===== STATISTICS SECTION =====

      const statsGrid = document.querySelector(".grid-cols-2.md\\:grid-cols-4");
      if (statsGrid) {
        const statItems = statsGrid.querySelectorAll(".text-center");

        statItems.forEach((statItem) => {
          const valueElement = statItem.querySelector(
            ".text-4xl.md\\:text-5xl",
          );
          if (valueElement) {
            const text = valueElement.textContent || "";
            const numMatch = text.match(/\\d+/);

            if (numMatch) {
              const targetValue = parseInt(numMatch[0]);
              const suffix = text.replace(/\\d+/, "");

              ScrollTrigger.create({
                trigger: statItem,
                start: "top 85%",
                onEnter: () => {
                  const obj = { value: 0 };
                  gsap.to(obj, {
                    value: targetValue,
                    duration: 2,
                    ease: "power2.out",
                    onUpdate: () => {
                      valueElement.textContent = Math.round(obj.value) + suffix;
                    },
                  });
                },
              });
            }
          }
        });

        // Stat items fade in
        gsap.from(statItems, {
          scrollTrigger: {
            trigger: statsGrid,
            start: "top 80%",
          },
          y: 40,
          opacity: 0,
          duration: 0.8,
          stagger: 0.15,
          ease: "power3.out",
        });
      }

      console.log("🎨 Animations initialized!");
    });
  </script>

  <!-- Add particle canvas for hero section -->
  <canvas
    id="particle-canvas"
    style="position: fixed; top: 0; left: 0; width: 100%; height: 100vh; pointer-events: none; z-index: 0; opacity: 0.3;"
  ></canvas>

  <!-- Three.js Particle System -->
  <script>
    import { ParticleSystem } from "../utils/three-scene";

    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    if (!prefersReducedMotion) {
      window.addEventListener("load", () => {
        const canvas = document.getElementById(
          "particle-canvas",
        ) as HTMLCanvasElement;
        if (canvas) {
          new ParticleSystem(canvas);
        }
      });
    }
  </script>
</BaseLayout>
