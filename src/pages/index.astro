---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection, getEntry } from "astro:content";
import type { CollectionEntry } from "astro:content";

// Fetch homepage content from collection
const home = await getEntry("pages", "home");
if (!home) {
  throw new Error("Homepage content not found in collections");
}

// Explicitly type the data to help TypeScript
type HomeData = CollectionEntry<"pages">["data"];
const data: HomeData = home.data;

const {
  approach,
  currentProject,
  stats,
  availability,
  skills,
  social,
  email,
  services,
} = data;

// Fetch latest articles
const allArticles = await getCollection("articles");
const latestArticles = allArticles
  .sort(
    (a, b) =>
      new Date(b.data.publishedDate).getTime() -
      new Date(a.data.publishedDate).getTime(),
  )
  .slice(0, 3);
---

<BaseLayout title={home.data.title} description={home.data.description}>
  <section class="pt-32 px-6 bg-white">
    <div class="max-w-7xl mx-auto">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
