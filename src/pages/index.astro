  </section>
  <!-- Current Project Section -->
  <section id="current-work" class="py-24 relative">
    <div class="max-w-7xl mx-auto px-6 mt-16">
      <!-- Header with Decorative Elements -->
      <div class="text-center mb-16 relative">
        <!-- Diagonal Lines - Top Right -->
        <div class="absolute right-0 top-0">
          <svg width="60" height="60" viewBox="0 0 60 60" fill="none">
            <line x1="10" y1="5" x2="50" y2="45" stroke="black" stroke-width="2"
            ></line>
            <line x1="20" y1="5" x2="60" y2="45" stroke="black" stroke-width="2"
            ></line>
            <line x1="0" y1="15" x2="40" y2="55" stroke="black" stroke-width="2"
            ></line>
            <line
              x1="10"
              y1="15"
              x2="50"
              y2="55"
              stroke="black"
              stroke-width="2"></line>
          </svg>
        </div>
        <div class="absolute left-1/2 -translate-x-1/2 -top-20">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="80"
            height="80"
            viewBox="0 0 100 100"
            fill="none"
            class="text-black"
          >
            <!-- Center Circle -->
            <circle cx="50" cy="50" r="5" fill="currentColor"></circle>

            <!-- Radiating Lines (Sunburst Pattern) -->
            <g stroke="currentColor" stroke-width="0.5" opacity="0.6">
              {/* 360 degrees, 72 lines (every 5 degrees) */}
              {
                Array.from({ length: 72 }).map((_, i) => {
                  const angle = (i * 5 * Math.PI) / 180;
                  const x1 = 50 + Math.cos(angle) * 8;
                  const y1 = 50 + Math.sin(angle) * 8;
                  const x2 = 50 + Math.cos(angle) * 40;
                  const y2 = 50 + Math.sin(angle) * 40;
                  return <line x1={x1} y1={y1} x2={x2} y2={y2} />;
                })
              }
            </g>
          </svg>
        </div>

        <h2 class="text-5xl md:text-6xl font-bold mb-4 tracking-tight">
          CURRENT PROJECT
        </h2>
        <p class="text-base text-black/60 max-w-2xl mx-auto">
          {currentProject.description}
        </p>
      </div>

      <!-- Project Card -->
      <div class="bg-black text-white rounded-lg overflow-hidden">
        <div class="flex flex-col md:flex-row items-center md:items-stretch">
          <!-- Number Indicator -->
          <div
            class="bg-black/40 px-8 py-8 md:py-12 flex items-center justify-center border-r border-white/10"
          >
            <span class="text-4xl md:text-5xl font-bold text-white/40">1</span>
          </div>

          <!-- Project Info -->
          <div class="flex-1 px-8 py-8 md:py-12">
            <h3 class="text-2xl md:text-3xl font-bold mb-2">
              {currentProject.name}
            </h3>
            <p class="text-white/60 mb-4">
              {currentProject.client}
            </p>

            <!-- Technologies -->
            <div class="flex flex-wrap gap-2">
              {
                currentProject.technologies.map((tech) => (
                  <span class="px-3 py-1 bg-white/10 rounded text-sm text-white/80">
                    {tech}
                  </span>
                ))
              }
            </div>
          </div>

          <!-- Timeline -->
          <div
            class="px-8 py-8 md:py-12 flex items-center border-t md:border-t-0 md:border-l border-white/10"
          >
            <div class="text-right">
              <p class="text-xs text-white/40 uppercase tracking-wider mb-1">
                Duration
              </p>
              <p class="text-sm font-medium text-white">
                {
                  currentProject.timeline.split("—")[1]?.trim() ||
                    currentProject.timeline
                }
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- About Preview Section -->
  <section class="py-24 relative bg-gradient-to-b from-white to-gray-50">
    <div class="max-w-6xl mx-auto px-6">
      <!-- Header with Decorative Element -->
      <div class="text-center mb-16 relative">
        <!-- Dotted Pattern Decorative Element - Top Left -->
        <div class="absolute left-0 -top-8">
          <svg width="80" height="120" viewBox="0 0 80 120" fill="none">
            <defs>
              <radialGradient id="dotGradient" cx="50%" cy="50%" r="50%">
                <stop offset="0%" style="stop-color:black;stop-opacity:1"
                ></stop>
                <stop offset="100%" style="stop-color:black;stop-opacity:0.1"
                ></stop>
              </radialGradient>
            </defs>
            {/* Dot grid pattern with gradient fade */}
            {
              Array.from({ length: 12 }).map((_, row) => (
                <g>
                  {Array.from({ length: 5 }).map((_, col) => {
                    const opacity = 1 - col * 0.2;
                    return (
                      <circle
                        cx={15 + col * 12}
                        cy={15 + row * 10}
                        r="2.5"
                        fill="black"
                        opacity={opacity}
                      />
                    );
                  })}
                </g>
              ))
            }
          </svg>
        </div>

        <p class="text-sm uppercase tracking-widest text-black/50 mb-4">
          About
        </p>
        <h2 class="text-4xl md:text-5xl font-bold mb-6 leading-tight">
          Full Stack .NET<br />& AI Expert
        </h2>
        <p class="text-lg text-black/70 max-w-2xl mx-auto mb-8">
          I craft scalable, AI-powered cloud-native applications with a focus on
          performance, security, and long-term maintainability.
        </p>
        <a
          href="/about"
          class="inline-flex items-center gap-2 text-base font-medium hover:gap-4 transition-all text-black/80 hover:text-black group"
        >
          <span>Learn more</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            class="transition-transform group-hover:translate-x-1"
          >
            <path d="M5 12h14"></path>
            <path d="m12 5 7 7-7 7"></path>
          </svg>
        </a>
      </div>

      <!-- Stats Grid -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
        {
          stats.map((stat) => (
            <div class="text-center">
              <div class="text-4xl md:text-5xl font-bold mb-2 text-black">
                {stat.value}
              </div>
              <div class="text-sm text-black/60 uppercase tracking-wider">
                {stat.label}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Articles Section -->
  <section class="py-24 relative bg-white">
    <div class="max-w-6xl mx-auto px-6">
      <!-- Header with Decorative Element -->
      <div class="text-center mb-16 relative">
