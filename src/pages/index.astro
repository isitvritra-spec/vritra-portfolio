  <!-- Animation Script -->
  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    import { initSmoothScroll } from '../utils/smooth-scroll';

    // Register plugins
    gsap.registerPlugin(ScrollTrigger);

    // Check for reduced motion preference
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Initialize on DOM load
    document.addEventListener('DOMContentLoaded', () => {
      if (prefersReducedMotion) {
        // Significantly reduce animation complexity for users who prefer reduced motion
        gsap.globalTimeline.timeScale(20);
        return;
      }

      // Initialize smooth scroll
      initSmoothScroll();

      // ===== HERO SECTION ANIMATIONS =====
      
      console.log('🚀 Hero animations starting...');

      // Heading reveal
      gsap.from('h1', {
        y: 40,
        opacity: 0,
        duration: 0.8,
        ease: 'power3.out',
        delay: 0.4,
        onComplete: () => console.log('✅ Heading animated')
      });

      // Role line animation
      gsap.from('.hero-role-line', {
        width: 0,
        opacity: 0,
        duration: 1,
        ease: 'power2.out',
        delay: 0.6,
        onComplete: () => console.log('✅ Role line animated')
      });

      // Description fade in
      gsap.from('.heroDescription', {
        y: 30,
        opacity: 0,
        duration: 0.6,
        delay: 0.8
      });

      // Approach cards stagger
      const cards = document.querySelectorAll('.approach-cards > div');
      console.log(`🎯 Found ${cards.length} approach cards`);
      gsap.fromTo(cards, 
        {
          y: 30,
          opacity: 0,
          visibility: 'hidden'
        },
        {
          y: 0,
          opacity: 1,
          visibility: 'visible',
          duration: 0.5,
          stagger: 0.1,
          delay: 1,
          ease: 'power2.out',
          onComplete: () => console.log('✅ Approach cards animated')
        }
      );

      // CTA Buttons with magnetic effect
      const ctaButtons = document.querySelectorAll('.hero-ctas a');
      console.log(`🎯 Found ${ctaButtons.length} CTA buttons`);
      gsap.fromTo(ctaButtons, 
        { 
          y: 20, 
          opacity: 0,
          visibility: 'hidden'
        },
        {
          y: 0,
          opacity: 1,
          visibility: 'visible',
          duration: 0.6,
          stagger: 0.15,
          delay: 1.2,
          ease: 'back.out(1.5)',
          onComplete: () => console.log('✅ CTA buttons animated')
        }
      );

      // Magnetic hover effect for buttons
      ctaButtons.forEach(button => {
        const btn = button as HTMLElement;
        
        btn.addEventListener('mouseenter', () => {
          gsap.to(btn, {
            scale: 1.05,
            duration: 0.3,
            ease: 'power2.out'
          });
        });

        btn.addEventListener('mousemove', (e: MouseEvent) => {
          const rect = btn.getBoundingClientRect();
          const x = e.clientX - rect.left - rect.width / 2;
          const y = e.clientY - rect.top - rect.height / 2;

          gsap.to(btn, {
            x: x * 0.2,
            y: y * 0.2,
            duration: 0.3,
            ease: 'power2.out'
          });
        });

        btn.addEventListener('mouseleave', () => {
          gsap.to(btn, {
            x: 0,
            y: 0,
            scale: 1,
            duration: 0.5,
            ease: 'elastic.out(1, 0.5)'
          });
        });
      });

      // Profile image section animations
      const profileSection = document.querySelector('.relative.hidden.lg\\:block');
      if (profileSection) {
        // Hello badge bounce animation
        const helloBadge = profileSection.querySelector('.absolute.bottom-40');
        if (helloBadge) {
          gsap.from(helloBadge, {
            scale: 0,
            rotation: 360,
            duration: 1,
            ease: 'elastic.out(1, 0.6)',
            delay: 0.5
          });

          // Continuous subtle pulse
          gsap.to(helloBadge, {
            scale: 1.05,
            duration: 2,
            repeat: -1,
            yoyo: true,
            ease: 'sine.inOut'
          });
        }

        // Decorative lines animation
        const decorativeLines = profileSection.querySelectorAll('.absolute.w-16, .absolute.w-8');
        decorativeLines.forEach((line, index) => {
          gsap.from(line, {
            scaleX: 0,
            opacity: 0,
            duration: 0.8,
            delay: 0.6 + index * 0.1,
            ease: 'power2.out'
          });
        });

        // Profile image fade in
        const profileImg = profileSection.querySelector('img');
        if (profileImg) {
          gsap.from(profileImg, {
            scale: 0.8,
            opacity: 0,
            duration: 1,
            ease: 'power3.out',
            delay: 0.3
          });
        }

        // SVG decoration entrance only (no continuous rotation)
        const svgDecoration = profileSection.querySelector('svg.absolute.-top-12');
        if (svgDecoration) {
          gsap.from(svgDecoration, {
            opacity: 0,
            duration: 0.8,
            ease: 'power2.out',
            delay: 0.8
          });
        }
      }

      // ===== HERO IMAGE CAROUSEL =====
      
      const carouselImages = document.querySelectorAll('.carousel-image');
      let currentIndex = 0;
      let carouselInterval: number | null = null;

      function rotateImages() {
        const current = carouselImages[currentIndex];
        const nextIndex = (currentIndex + 1) % carouselImages.length;
        const next = carouselImages[nextIndex];
        
        // Fade out current image with subtle scale
        gsap.to(current, {
          opacity: 0,
          scale: 1.05,
          duration: 1,
          ease: 'power2.inOut',
          onComplete: () => {
            current.classList.remove('active');
          }
        });
        
        // Fade in next image
        gsap.fromTo(next, 
          { opacity: 0, scale: 0.95 },
          { 
            opacity: 1, 
            scale: 1, 
            duration: 1,
            ease: 'power2.inOut',
            onStart: () => {
              next.classList.add('active');
            }
          }
        );
        
        currentIndex = nextIndex;
      }

      // Start auto-rotation every 4 seconds
      function startCarousel() {
        carouselInterval = window.setInterval(rotateImages, 4000);
      }

      function stopCarousel() {
        if (carouselInterval) {
          clearInterval(carouselInterval);
          carouselInterval = null;
        }
      }

      // Initialize carousel
      startCarousel();

      // Pause on hover
      const carousel = document.querySelector('.image-carousel');
      if (carousel) {
        carousel.addEventListener('mouseenter', stopCarousel);
        carousel.addEventListener('mouseleave', startCarousel);
      }

      // ===== MARQUEE SECTION =====
      
      const marqueeContainer = document.querySelector('.bg-black.py-6');
      if (marqueeContainer) {
        const skillsContainer = marqueeContainer.querySelector('.flex.flex-wrap');
        
        if (skillsContainer) {
          // Clone skills for infinite scroll effect
          const skills = Array.from(skillsContainer.children);
          skills.forEach(skill => {
            const clone = skill.cloneNode(true) as HTMLElement;
            skillsContainer.appendChild(clone);
          });

          // Sparkles remain static for cleaner appearance
        }
      }

      // Social icons bounce on hover
      const socialLinks = document.querySelectorAll('.flex.items-center.gap-2.text-black\\/70');
      socialLinks.forEach(link => {
        link.addEventListener('mouseenter', () => {
          const icon = link.querySelector('span.text-sm');
          if (icon) {
            gsap.to(icon, {
              y: -5,
              duration: 0.3,
              ease: 'power2.out'
            });
          }
        });

        link.addEventListener('mouseleave', () => {
          const icon = link.querySelector('span.text-sm');
          if (icon) {
            gsap.to(icon, {
              y: 0,
              duration: 0.3,
              ease: 'bounce.out'
            });
          }
        });
      });

      // ===== SERVICES SECTION =====
      
      // Section header reveal
      gsap.from('.text-4xl.lg\\:text-6xl', {
        scrollTrigger: {
          trigger: '.text-4xl.lg\\:text-6xl',
          start: 'top 80%',
        },
        y: 60,
        opacity: 0,
        duration: 0.8,
        ease: 'power3.out'
      });

      // Service cards with 3D tilt effect
      const serviceCards = document.querySelectorAll('.grid.flex-1 > div');
      
      // No entrance animation - cards appear immediately

      // Add 3D tilt hover effect to each card
      serviceCards.forEach(card => {
        const cardEl = card as HTMLElement;
        let isHovering = false;

        cardEl.addEventListener('mouseenter', () => {
          isHovering = true;
          gsap.to(cardEl, {
            scale: 1.03,
            duration: 0.3,
            ease: 'power2.out'
          });
          // Icon animation removed for cleaner interaction
        });

        cardEl.addEventListener('mousemove', (e: MouseEvent) => {
          if (!isHovering) return;

          const rect = cardEl.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;
          
          const centerX = rect.width / 2;
          const centerY = rect.height / 2;
          
          const rotateX = ((y - centerY) / centerY) * -8;
          const rotateY = ((x - centerX) / centerX) * 8;

          gsap.to(cardEl, {
            rotationX: rotateX,
            rotationY: rotateY,
            transformPerspective: 1000,
            duration: 0.3,
            ease: 'power2.out'
          });
        });

        cardEl.addEventListener('mouseleave', () => {
          isHovering = false;
          gsap.to(cardEl, {
            scale: 1,
            rotationX: 0,
            rotationY: 0,
            transformPerspective: 1000,
            duration: 0.4,
            ease: 'power2.out'
          });
          // Icon reset removed since icon animation is removed
        });
      });

      // ===== CURRENT PROJECT SECTION =====
      
      // Sunburst appears with simple fade (no rotation distraction)

      // Diagonal lines draw animation
      const diagonalLines = document.querySelectorAll('.absolute.right-0.top-0 line');
      gsap.from(diagonalLines, {
        scrollTrigger: {
          trigger: '#current-work',
          start: 'top 75%',
        },
        scaleX: 0,
        opacity: 0,
        duration: 0.6,
        stagger: 0.1,
        ease: 'power2.out'
      });

      // Project card slide in (optimized timing)
      const projectCard = document.querySelector('.bg-black.text-white.rounded-lg');
      if (projectCard) {
        gsap.from(projectCard, {
          scrollTrigger: {
            trigger: projectCard,
            start: 'top 80%',
          },
          y: 40, // Reduced from -100 for subtler entrance
          opacity: 0,
          duration: 0.6, // Faster from 1s
          ease: 'power3.out'
        });

        // Technology tags stagger (faster timing)
        const techTags = projectCard.querySelectorAll('.flex.flex-wrap.gap-2 > span');
        gsap.from(techTags, {
          scrollTrigger: {
            trigger: projectCard,
            start: 'top 70%',
          },
          scale: 0,
          opacity: 0,
          duration: 0.4, // Slightly faster
          stagger: 0.05, // Reduced from 0.1s for snappier feel
          ease: 'back.out(1.7)'
        });
      }

      // ===== STATISTICS SECTION =====
      
      const statsSection = document.querySelector('.grid.grid-cols-2.md\\:grid-cols-4.gap-8');
      if (statsSection) {
        const statItems = statsSection.querySelectorAll('.text-center');
        
        statItems.forEach(statItem => {
          const valueElement = statItem.querySelector('.text-4xl.md\\:text-5xl');
          if (valueElement) {
            const text = valueElement.textContent || '';
            const numMatch = text.match(/\\d+/);
            
            if (numMatch) {
              const targetValue = parseInt(numMatch[0]);
              const suffix = text.replace(/\\d+/, '');

              ScrollTrigger.create({
                trigger: statItem,
                start: 'top 85%',
                onEnter: () => {
                  const obj = { value: 0 };
                  gsap.to(obj, {
                    value: targetValue,
                    duration: 2,
                    ease: 'power2.out',
                    onUpdate: () => {
                      valueElement.textContent = Math.round(obj.value) + suffix;
                    }
                  });
                }
              });
            }
          }
        });

        // Stat items fade in
        gsap.from(statItems, {
          scrollTrigger: {
            trigger: statsSection,
            start: 'top 80%',
          },
          y: 40,
          opacity: 0,
          duration: 0.8,
          stagger: 0.15,
          ease: 'power3.out'
        });
      }

      // Dot pattern removed - reduces perceived load time

      // ===== GLOBAL PARALLAX EFFECTS =====
      // Removed excessive parallax on decorative elements to reduce visual noise

      console.log('🎨 Animations initialized!');
    });
  </script>

  <!-- Add particle canvas for hero section -->
  <canvas
    id="particle-canvas"
    style="position: fixed; top: 0; left: 0; width: 100%; height: 100vh; pointer-events: none; z-index: 0; opacity: 0.3;"
  ></canvas>

  <!-- Three.js Particle System -->
  <script>
    import { ParticleSystem } from '../utils/three-scene';

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!prefersReducedMotion) {
      window.addEventListener('load', () => {
        const canvas = document.getElementById('particle-canvas') as HTMLCanvasElement;
        if (canvas) {
          new ParticleSystem(canvas);
        }
      });
    }
  </script>
</BaseLayout>
