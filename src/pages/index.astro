                >
                </div>
              </span>
            </div>
            <div
              class="absolute -top-8 -left-8 w-16 h-0.5 bg-black transform -rotate-45 z-0"
            >
            </div>
            <div
              class="absolute -top-4 -left-10 w-8 h-0.5 bg-black transform -rotate-12 z-0"
            >
            </div>
            <div class="relative aspect-square rounded-2xl overflow-hidde z-10">
              <img
                src="/profile.png"
                alt="Is It Vritra"
                class="w-full h-full object-cover relative z-10"
              />
            </div>
            <svg
              class="absolute -top-12 -right-12 w-32 h-32 text-black/20"
              viewBox="0 0 100 100"
            >
              <path
                d="M10 50 Q 30 10, 50 50 T 90 50"
                stroke="currentColor"
                stroke-width="2"
                fill="none"></path>
              <path d="M20 70 L 80 30" stroke="currentColor" stroke-width="2"
              ></path>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </section>
  <section class="relative mb-20">
    <div class="bg-black py-6 transform overflow-hidden">
      <div class="max-w-7xl mx-auto px-8">
        <div
          class="flex flex-wrap items-center justify-center gap-4 md:gap-8 text-white transform skew-y-1"
        >
          {
            skills.map((skill, index) => (
              <>
                <span class="text-xs md:text-base font-bold tracking-widest whitespace-nowrap">
                  {skill}
                </span>
                {index < skills.length - 1 && (
                  <span class="text-lg md:text-xl">✦</span>
                )}
              </>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Social links -->
    <div class="max-w-7xl mx-auto px-8 mt-10">
      <div class="flex flex-wrap items-center justify-center gap-6 text-xs">
        <div class="hidden md:block flex-1 h-px bg-black/10"></div>

        {
          social.map((link) => (
            <a
              href={link.url}
              class="flex items-center gap-2 text-black/70 hover:text-black transition-colors"
            >
              <span class="text-sm">
                {link.platform === "FACEBOOK" && "📘"}
                {link.platform === "YOUTUBE" && "📺"}
                {link.platform === "TWITTER" && "🐦"}
              </span>
              <span class="font-medium tracking-wide">{link.platform}</span>
            </a>
          ))
        }

        <div class="flex items-center gap-2 text-black/70">
          <span class="text-sm">✉️</span>
          <span class="font-medium tracking-wide">{email}</span>
        </div>

        <div class="hidden md:block flex-1 h-px bg-black/10"></div>
      </div>
    </div>
  </section>

  <!-- approach Section -->
  <section class="py-10 px-6 bg-white relative">
    <div class="max-w-7xl mx-auto pl-8">
      <!-- Header -->
      <div class="flex items-start justify-between mb-16">
        <div class="space-y-4">
          <p class="text-xs tracking-widest text-black/60 font-medium">
            — MY approach ?
          </p>
          <h2 class="text-4xl lg:text-6xl font-bold text-black">
            WHAT I'M<br />OFFERING
          </h2>
        </div>
        <div class="flex items-start gap-8 mt-10">
          <p class="text-sm text-black/60 max-w-md leading-relaxed">
            There are many variations of passages of Lorem Ipsum available, but
            the majority have suffered alteration in some form.
          </p>
          <a
            href="#"
            class="px-8 py-3.5 bg-black text-white rounded-full font-medium hover:bg-black/90 transition-all whitespace-nowrap"
          >
            ALL SERVICE
          </a>
        </div>
      </div>

      <!-- approach Grid -->
      <div class="relative flex gap-8 items-center">
        <!-- Scroll Indicator -->
        <div class="hidden lg:flex flex-col items-center gap-4 flex-shrink-0">
          <p
            class="text-xs tracking-wider font-medium"
            style="writing-mode: vertical-lr; transform: rotate(180deg);"
          >
            SCROLL DOWN
          </p>
          <div class="w-px h-24 bg-black/20"></div>
          <div
            class="w-12 h-12 rounded-full border-2 border-black flex items-center justify-center hover:bg-black hover:text-white transition-all cursor-pointer"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M12 5v14M19 12l-7 7-7-7"></path>
            </svg>
          </div>
        </div>

        <!-- Cards Grid -->
        <div class="grid md:grid-cols-3 gap-6 flex-1">
          {
            services.map((service, index) => (
              <div
                class={`p-10 rounded-lg transition-all hover:shadow-xl min-h-[320px] flex flex-col justify-between ${
                  service.featured
                    ? "bg-black text-white"
                    : "bg-white border-2 border-black/10 hover:border-black/30"
                }`}
              >
                <div>
                  {/* Icon */}
                  <div
                    class="mb-8"
                    set:html={service.icon.replace(
                      'width="24" height="24"',
                      'width="48" height="48"',
                    )}
                  />

                  {/* Title */}
                  <h3
                    class={`text-lg font-bold mb-4 leading-tight ${
                      service.featured ? "text-white" : "text-black"
                    }`}
                  >
                    {service.title}
                  </h3>

                  {/* Description - Initially Hidden */}
                  <p
                    class={`service-description text-sm leading-relaxed mb-4 overflow-hidden transition-all duration-300 ${
                      service.featured ? "text-white/70" : "text-black/60"
                    }`}
                    data-service-id={`service-${index}`}
                    style="max-height: 0; opacity: 0;"
                  >
                    {service.description}
                  </p>
                </div>

                {/* Read More Toggle */}
                <button
                  class={`read-more-btn inline-flex items-center gap-2 text-sm font-medium hover:gap-4 transition-all ${
                    service.featured
                      ? "text-white/80 hover:text-white"
                      : "text-black/60 hover:text-black"
                  }`}
                  data-service-id={`service-${index}`}
                >
                  <span class="btn-text">READ MORE</span>
                  <svg
                    class="arrow-icon transition-transform"
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path d="M5 12h14M12 5l7 7-7 7" />
                  </svg>
                </button>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <script>
      // Service card toggle functionality
      document.addEventListener("DOMContentLoaded", () => {
        const readMoreButtons = document.querySelectorAll(".read-more-btn");

        readMoreButtons.forEach((button) => {
          button.addEventListener("click", (e) => {
            e.preventDefault();
            const serviceId = button.getAttribute("data-service-id");
            const description = document.querySelector(
              `.service-description[data-service-id="${serviceId}"]`,
            ) as HTMLElement;
            const btnText = button.querySelector(".btn-text") as HTMLElement;
            const arrow = button.querySelector(".arrow-icon") as HTMLElement;

            if (description && btnText && arrow) {
              const isExpanded =
                description.style.maxHeight !== "0px" &&
                description.style.maxHeight !== "";

              if (isExpanded) {
                // Collapse
                description.style.maxHeight = "0";
                description.style.opacity = "0";
                description.style.marginBottom = "0";
                btnText.textContent = "READ MORE";
                arrow.style.transform = "rotate(0deg)";
              } else {
                // Expand
                description.style.maxHeight = description.scrollHeight + "px";
                description.style.opacity = "1";
                description.style.marginBottom = "1rem";
                btnText.textContent = "READ LESS";
                arrow.style.transform = "rotate(180deg)";
              }
            }
          });
        });
      });
    </script>

