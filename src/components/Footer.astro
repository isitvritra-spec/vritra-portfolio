---

<footer style="background: #1A1A1A; padding: 4rem 2rem 2rem; color: #FFFFFF;">
  <div style="max-width: 1120px; margin: 0 auto;">
    <!-- Top Section -->
    <div style="display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 4rem; margin-bottom: 3rem;">
      <!-- Brand -->
      <div>
        <a href="/" style="display: flex; align-items: center; gap: 1rem; text-decoration: none; margin-bottom: 1.5rem;">
          <img src="/profile.png" alt="Is It Vritra" style="width: 56px; height: 56px; border-radius: 50%; object-fit: cover;" />
          <div>
            <span style="display: block; font-size: 1.125rem; font-weight: 600; color: #FFFFFF;">Is It Vritra</span>
            <span style="font-size: 0.8125rem; color: #999;">Full Stack .NET & AI Expert</span>
          </div>
        </a>
        <p style="font-size: 0.9375rem; color: #999; line-height: 1.7; max-width: 320px; margin-bottom: 1.5rem;">
          Building secure, AI-integrated enterprise solutions for government and healthcare.
        </p>
        <!-- Social Icons -->
        <div style="display: flex; gap: 0.75rem;">
          {socials.map(social => (
            <a 
              href={social.href} 
              target="_blank" 
              rel="noopener" 
              aria-label={social.label}
              style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; background: rgba(255,255,255,0.08); border-radius: 10px; color: #999; transition: all 0.3s ease;"
              class="social-icon"
            >
              <span style="width: 18px; height: 18px;" set:html={social.icon}></span>
            </a>
          ))}
        </div>
      </div>
      
      <!-- Navigation -->
      <div>
        <span style="display: block; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: #666; margin-bottom: 1.25rem;">Navigate</span>
        <nav style="display: flex; flex-direction: column; gap: 0.75rem;">
          {links.map(link => (
            <a href={link.href} style="font-size: 0.9375rem; color: #999; text-decoration: none; transition: color 0.2s;" class="footer-link">{link.label}</a>
          ))}
        </nav>
      </div>
      
      <!-- Contact -->
      <div>
        <span style="display: block; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: #666; margin-bottom: 1.25rem;">Get in Touch</span>
        <nav style="display: flex; flex-direction: column; gap: 0.75rem;">
          <a href="mailto:info@isitvritra.com" style="font-size: 0.9375rem; color: #999; text-decoration: none; transition: color 0.2s;" class="footer-link">info@isitvritra.com</a>
          <span style="font-size: 0.875rem; color: #666;">Response within 24 hours</span>
        </nav>
      </div>
    </div>
    
    <!-- Bottom -->
    <div style="border-top: 1px solid rgba(255,255,255,0.08); padding-top: 2rem; display: flex; justify-content: space-between; align-items: center;">
      <span style="font-size: 0.8125rem; color: #666;">© {year} Is It Vritra. All rights reserved.</span>
      <span style="font-size: 0.8125rem; color: #666;">Built with passion in India 🇮🇳</span>
    </div>
  </div>
</footer>

<style>
  .social-icon:hover {
    background: #E85D04 !important;
    color: #FFFFFF !important;
    transform: translateY(-2px);
  }
  
  .footer-link:hover {
    color: #FFFFFF !important;
  }
  
  @media (max-width: 768px) {
    footer {
      padding: 3rem 1.5rem 1.5rem !important;
    }
    
    footer > div > div:first-child {
      grid-template-columns: 1fr !important;
      gap: 2rem !important;
    }
    
    footer > div > div:last-child {
      flex-direction: column !important;
      gap: 0.5rem !important;
      text-align: center !important;
    }
  }
</style>
