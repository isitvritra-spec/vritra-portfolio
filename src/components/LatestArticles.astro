---
interface Props {
    latestArticles: any[];
}

const { latestArticles } = Astro.props;
---

<section class="py-24 relative bg-white">
    <div class="max-w-6xl mx-auto px-6">
        <!-- Header with Decorative Element -->
        <div class="text-center mb-16 relative">
            <!-- Diagonal Lines Decorative Element - Top Right -->
            <div class="absolute right-0 -top-8">
                <svg width="60" height="60" viewBox="0 0 60 60" fill="none">
                    <line
                        x1="10"
                        y1="5"
                        x2="50"
                        y2="45"
                        stroke="black"
                        stroke-width="2"></line>
                    <line
                        x1="20"
                        y1="5"
                        x2="60"
                        y2="45"
                        stroke="black"
                        stroke-width="2"></line>
                    <line
                        x1="0"
                        y1="15"
                        x2="40"
                        y2="55"
                        stroke="black"
                        stroke-width="2"></line>
                    <line
                        x1="10"
                        y1="15"
                        x2="50"
                        y2="55"
                        stroke="black"
                        stroke-width="2"></line>
                </svg>
            </div>

            <h2 class="text-5xl md:text-6xl font-bold mb-4 tracking-tight">
                LATEST ARTICLES
            </h2>
            <p class="text-base text-black/60 max-w-2xl mx-auto mb-6">
                Insights, tutorials, and deep dives into modern software
                development, AI, and cloud architecture
            </p>
            <a
                href="/articles"
                class="inline-flex items-center gap-2 text-base font-medium hover:gap-4 transition-all text-black/80 hover:text-black"
            >
                <span>View all articles</span>
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                >
                    <path d="M5 12h14"></path>
                    <path d="m12 5 7 7-7 7"></path>
                </svg>
            </a>
        </div>

        <!-- Articles Grid -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {
                latestArticles.map((article) => (
                    <a
                        href={`/articles/${article.slug}`}
                        class="group block bg-black text-white rounded-lg overflow-hidden hover:bg-black/90 hover:shadow-xl transition-all"
                    >
                        {article.data.image && (
                            <div class="aspect-video overflow-hidden bg-gray-900">
                                <img
                                    src={article.data.image}
                                    alt={article.data.title}
                                    loading="lazy"
                                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                                />
                            </div>
                        )}
                        <div class="p-6">
                            <span class="inline-block px-3 py-1 bg-white/10 text-white/90 text-xs font-medium uppercase tracking-wider rounded mb-3">
                                {article.data.category}
                            </span>
                            <h3 class="text-lg font-bold mb-2 leading-tight group-hover:text-white/80 transition-colors">
                                {article.data.title}
                            </h3>
                            <span class="text-sm text-white/60">
                                {article.data.readTime} min read
                            </span>
                        </div>
                    </a>
                ))
            }
        </div>
    </div>
</section>
