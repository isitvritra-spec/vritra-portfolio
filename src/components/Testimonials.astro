---

---

<section id="testimonials" class="py-20 bg-gray-50">
    <div class="max-w-4xl mx-auto px-6">
        <div class="text-center mb-12">
            <p class="text-sm uppercase tracking-widest text-black/40 mb-3">
                AI Tutoring Sessions
            </p>
            <h2 class="text-3xl md:text-4xl font-bold text-black">
                Client Stories
            </h2>
        </div>

        <div
            class="bg-white rounded-2xl p-8 md:p-12 shadow-lg border border-gray-100 relative"
        >
            <!-- Quote Icon -->
            <div class="absolute -top-6 left-8">
                <div
                    class="w-12 h-12 bg-black rounded-full flex items-center justify-center"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="white"
                    >
                        <path
                            d="M11.192 15.757c0-.88-.23-1.618-.69-2.217-.326-.412-.768-.683-1.327-.812-.55-.128-1.07-.137-1.54-.028-.16-.95.1-1.956.76-3.022.66-1.065 1.515-1.867 2.558-2.403L9.373 5c-.8.396-1.56.898-2.26 1.505-.71.607-1.34 1.305-1.9 2.094s-.98 1.68-1.25 2.69-.346 2.04-.217 3.1c.168 1.4.62 2.52 1.356 3.35.735.84 1.652 1.26 2.748 1.26.965 0 1.766-.29 2.4-.878.628-.576.94-1.365.94-2.368l.002.003zm9.124 0c0-.88-.23-1.618-.69-2.217-.326-.42-.768-.69-1.327-.817-.55-.124-1.07-.13-1.54-.022-.16-.94.09-1.95.75-3.02.66-1.06 1.514-1.86 2.557-2.4L18.49 5c-.8.396-1.555.898-2.26 1.505-.708.607-1.34 1.305-1.894 2.094-.556.79-.97 1.68-1.24 2.69-.273 1-.345 2.04-.217 3.1.165 1.4.615 2.52 1.35 3.35.732.833 1.646 1.25 2.742 1.25.967 0 1.768-.29 2.402-.876.627-.576.942-1.365.942-2.368v.01z"
                        ></path>
                    </svg>
                </div>
            </div>

            <!-- Sessions Badge -->
            <div class="absolute -top-4 right-8">
                <span
                    class="px-3 py-1 bg-black text-white text-xs font-medium rounded-full"
                    >10 Sessions</span
                >
            </div>

            <div class="pt-4">
                <p
                    class="text-lg md:text-xl text-black/80 leading-relaxed mb-8"
                >
                    "I hired Vritra as an AI tutor, and he has proven to be an
                    enthusiastic and dedicated teacher who thoughtfully curates
                    lessons to align with my needs and areas of interest. He is
                    attentive, maintains open communication, and demonstrates
                    flexibility through his use of a wide range of tools for
                    lesson delivery. He also enriches our sessions by sharing
                    fun and interesting facts about the world of AI, which makes
                    the learning process more engaging. His passion,
                    adaptability, and depth of knowledge greatly enhance the
                    learning experience."
                </p>

                <div class="flex flex-wrap items-center justify-between gap-4">
                    <div class="flex items-center gap-4">
                        <div
                            class="w-14 h-14 rounded-full overflow-hidden border-2 border-gray-200"
                        >
                            <img
                                src="/clients/student-1.jpg"
                                alt="Helen Émilie K"
                                class="w-full h-full object-cover"
                            />
                        </div>
                        <div>
                            <p class="font-semibold text-black">
                                Helen Émilie K, PMP®
                            </p>
                            <p class="text-sm text-black/60">
                                Project Manager | AI Automation Consultant
                            </p>
                            <p class="text-xs text-black/40">
                                Vancouver, British Columbia, Canada
                            </p>
                        </div>
                    </div>

                    <!-- Book Session CTA -->
                    <a
                        href="/contact"
                        class="inline-flex items-center gap-2 px-6 py-3 bg-black text-white font-medium rounded-full hover:bg-black/80 transition-all"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="18"
                            height="18"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                        >
                            <rect
                                x="3"
                                y="4"
                                width="18"
                                height="18"
                                rx="2"
                                ry="2"></rect>
                            <line x1="16" y1="2" x2="16" y2="6"></line>
                            <line x1="8" y1="2" x2="8" y2="6"></line>
                            <line x1="3" y1="10" x2="21" y2="10"></line>
                        </svg>
                        <span>Book a Session</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
