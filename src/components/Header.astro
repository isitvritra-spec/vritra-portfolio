---
const navLinks = [
  {
    label: "My Projects",
    href: "/articles",
    subtitle: "See all of nice project I have done.",
    icon: "↗",
  },
  {
    label: "About Me",
    href: "/about",
    subtitle: "Learn about my self what I do",
    icon: "↗",
  },
  {
    label: "Contact me",
    href: "/contact",
    subtitle: "info.madhu786@gmail.com",
    icon: "↗",
  },
];

const socials = [
  {
    label: "Medium",
    href: "https://medium.com/@isitvritra101",
    icon: `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M13.54 12a6.8 6.8 0 01-6.77 6.82A6.8 6.8 0 010 12a6.8 6.8 0 016.77-6.82A6.8 6.8 0 0113.54 12zm7.42 0c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42 3.38 2.88 3.38 6.42M24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12z"/></svg>`,
  },
  {
    label: "YouTube",
    href: "https://www.youtube.com/@101Vritra",
    icon: `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>`,
  },
  {
    label: "LinkedIn",
    href: "https://linkedin.com/in/isitvritra",
    icon: `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>`,
  },
];
---

<header
  class="fixed top-0 left-0 right-0 z-50 bg-white border-b border-gray-100"
>
  <!-- Large gradient spot (centered around nav cards) -->
  <div
    class="absolute -top-32 right-150 w-[200px] h-[300px] bg-gradient-to-br from-pink-200 via-yellow-200 to-blue-200 rounded-full blur-3xl opacity-40 pointer-events-none"
  >
  </div>

  <div class="relative max-w-7xl mx-auto py-4">
    <div class="flex items-center justify-between">
      <!-- Logo with decorative lines -->
      <div class="relative">
        <!-- Decorative diagonal lines -->
        <svg
          class="absolute -left-8 -top-2 w-12 h-12 text-black/20"
          viewBox="0 0 48 48"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <line
            x1="10"
            y1="5"
            x2="25"
            y2="20"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"></line>
          <line
            x1="15"
            y1="8"
            x2="30"
            y2="23"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"></line>
        </svg>
        
        <a
          href="/"
          class="text-2xl font-normal text-black"
        >
         👋 <span class="underline  decoration-1 underline-offset-4 hover:no-underline transition-all"> Is It Vritra? </span>
        </a>
      </div>

      <!-- Navigation Cards - Desktop -->
      <nav class="hidden md:flex gap-3">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="backdrop-blur-sm rounded-2xl px-5 py-4 w-[200px] transition-all group"
            >
              <div class="flex items-start justify-between border-t border-black/60">
                <div>
                  <span class="text-sm font-semibold text-black">
                    {link.label}
                  </span>
                  <p class="text-xs text-stone-700 w-[125px]">
                    {link.subtitle}
                  </p>
                </div>
                <span class="text-black/70 group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform">
                  {link.icon}
                </span>
              </div>
            </a>
          ))
        }
      </nav>

      <!-- Mobile Menu Button -->
      <button class="md:hidden mobile-menu-btn p-2" aria-label="Toggle menu">
        <div class="w-6 h-5 flex flex-col justify-between">
          <span
            class="hamburger-line w-full h-0.5 bg-black rounded transition-all"
          ></span>
          <span
            class="hamburger-line w-full h-0.5 bg-black rounded transition-all"
          ></span>
          <span
            class="hamburger-line w-full h-0.5 bg-black rounded transition-all"
          ></span>
        </div>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Menu -->
<div
  id="mobile-menu"
  class="hidden fixed inset-0 bg-gradient-to-br from-pink-200 via-blue-200 via-yellow-100 to-green-100 z-50 p-8"
>
  <div class="flex justify-between items-start mb-8">
    <a
      href="/"
      class="text-2xl font-normal text-black underline decoration-2 underline-offset-4"
    >
      Is It Vritra?
    </a>
    <button class="mobile-menu-close p-2" aria-label="Close menu">
      <svg
        class="w-6 h-6"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <nav class="flex flex-col gap-4">
    {
      navLinks.map((link) => (
        <a
          href={link.href}
          class="bg-yellow-50/80 backdrop-blur-sm border border-black/10 rounded-2xl px-6 py-4 hover:bg-yellow-100/80 transition-all"
        >
          <div class="flex items-start justify-between mb-1">
            <span class="text-lg font-medium text-black">{link.label}</span>
            <span class="text-black/60">{link.icon}</span>
          </div>
          <p class="text-sm text-black/60">{link.subtitle}</p>
        </a>
      ))
    }
  </nav>

  <div class="flex gap-4 mt-8 pt-8 border-t border-black/10">
    {
      socials.map((social) => (
        <a
          href={social.href}
          target="_blank"
          rel="noopener"
          aria-label={social.label}
          class="w-12 h-12 flex items-center justify-center bg-yellow-50/80 rounded-xl hover:bg-yellow-100/80 transition-all"
        >
          <span class="w-5 h-5 text-black/70" set:html={social.icon} />
        </a>
      ))
    }
  </div>
</div>

<script>
  const mobileMenuBtn = document.querySelector(".mobile-menu-btn");
  const mobileMenuClose = document.querySelector(".mobile-menu-close");
  const mobileMenu = document.getElementById("mobile-menu");

  mobileMenuBtn?.addEventListener("click", () => {
    mobileMenu?.classList.remove("hidden");
    document.body.style.overflow = "hidden";
  });

  mobileMenuClose?.addEventListener("click", () => {
    mobileMenu?.classList.add("hidden");
    document.body.style.overflow = "";
  });

  // Close menu when clicking a link
  mobileMenu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      mobileMenu?.classList.add("hidden");
      document.body.style.overflow = "";
    });
  });
</script>
