---

---

<section class="relative mb-0">
    <div class="bg-black py-5 overflow-hidden">
        <div class="max-w-7xl mx-auto px-8">
            <div
                class="flex flex-wrap items-center justify-center gap-6 md:gap-10 text-white"
            >
                <!-- Achievement 1 -->
                <div class="flex items-center gap-3">
                    <div
                        class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="20"
                            height="20"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            class="text-white"
                        >
                            <circle cx="12" cy="12" r="10"></circle><path
                                d="M12 2v4"></path><path d="M12 18v4"
                            ></path><path d="m4.93 4.93 2.83 2.83"></path><path
                                d="m16.24 16.24 2.83 2.83"></path>
                        </svg>
                    </div>
                    <div>
                        <p
                            class="text-xs text-white/50 uppercase tracking-wider"
                        >
                            Current
                        </p>
                        <p class="text-sm font-semibold">UN Agency Project</p>
                    </div>
                </div>

                <div class="w-0.5 h-8 bg-white/30 hidden md:block"></div>

                <!-- Achievement 2 -->
                <div class="flex items-center gap-3">
                    <div
                        class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center"
                    >
                        <span class="text-xl font-bold">6+</span>
                    </div>
                    <div>
                        <p
                            class="text-xs text-white/50 uppercase tracking-wider"
                        >
                            Years
                        </p>
                        <p class="text-sm font-semibold">Experience</p>
                    </div>
                </div>

                <div class="w-0.5 h-8 bg-white/30 hidden md:block"></div>

                <!-- Achievement 3 -->
                <div class="flex items-center gap-3">
                    <div
                        class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="20"
                            height="20"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            class="text-white"
                        >
                            <path d="M12 8V4H8"></path><rect
                                width="16"
                                height="12"
                                x="4"
                                y="8"
                                rx="2"></rect><path d="M2 14h2"></path><path
                                d="M20 14h2"></path><path d="M15 13v2"
                            ></path><path d="M9 13v2"></path>
                        </svg>
                    </div>
                    <div>
                        <p
                            class="text-xs text-white/50 uppercase tracking-wider"
                        >
                            AI & GenAI
                        </p>
                        <p class="text-sm font-semibold">Solutions Expert</p>
                    </div>
                </div>

                <div class="w-0.5 h-8 bg-white/30 hidden md:block"></div>

                <!-- Achievement 4 -->
                <div class="flex items-center gap-3">
                    <div
                        class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="20"
                            height="20"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            class="text-white"
                        >
                            <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path><path
                                d="M6 12v5c3 3 9 3 12 0v-5"></path>
                        </svg>
                    </div>
                    <div>
                        <p
                            class="text-xs text-white/50 uppercase tracking-wider"
                        >
                            AI Tutoring
                        </p>
                        <p class="text-sm font-semibold">Sessions Available</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Social links -->
    <div class="max-w-7xl mx-auto px-8 mt-10">
        <div class="flex flex-wrap items-center justify-center gap-5 text-xs">
            <div class="hidden md:block flex-1 h-px bg-black/10"></div>

            <!-- LinkedIn -->
            <a
                href="https://linkedin.com/in/isitvritra"
                target="_blank"
                class="flex items-center gap-2 text-black/70 hover:text-black transition-colors"
            >
                <img
                    src="/social-medias/linkedin.png"
                    alt="LinkedIn"
                    class="w-5 h-5 object-contain"
                />
                <span class="font-medium tracking-wide">LINKEDIN</span>
            </a>

            <!-- GitHub -->
            <a
                href="https://github.com/isitvritra"
                target="_blank"
                class="flex items-center gap-2 text-black/70 hover:text-black transition-colors"
            >
                <img
                    src="/social-medias/github.png"
                    alt="GitHub"
                    class="w-5 h-5 object-contain"
                />
                <span class="font-medium tracking-wide">GITHUB</span>
            </a>

            <!-- Medium -->
            <a
                href="https://medium.com/@isitvritra"
                target="_blank"
                class="flex items-center gap-2 text-black/70 hover:text-black transition-colors"
            >
                <img
                    src="/social-medias/medium.png"
                    alt="Medium"
                    class="w-5 h-5 object-contain"
                />
                <span class="font-medium tracking-wide">MEDIUM</span>
            </a>

            <!-- YouTube -->
            <a
                href="https://youtube.com/@isitvritra"
                target="_blank"
                class="flex items-center gap-2 text-black/70 hover:text-black transition-colors"
            >
                <img
                    src="/social-medias/youtube.png"
                    alt="YouTube"
                    class="w-5 h-5 object-contain"
                />
                <span class="font-medium tracking-wide">YOUTUBE</span>
            </a>

            <!-- Instagram -->
            <a
                href="https://instagram.com/isitvritra"
                target="_blank"
                class="flex items-center gap-2 text-black/70 hover:text-black transition-colors"
            >
                <img
                    src="/social-medias/instagram.png"
                    alt="Instagram"
                    class="w-5 h-5 object-contain"
                />
                <span class="font-medium tracking-wide">INSTAGRAM</span>
            </a>

            <!-- WhatsApp -->
            <a
                href="https://wa.me/919286842595"
                target="_blank"
                class="flex items-center gap-2 text-black/70 hover:text-black transition-colors"
            >
                <img
                    src="/social-medias/whatsapp.png"
                    alt="WhatsApp"
                    class="w-5 h-5 object-contain"
                />
                <span class="font-medium tracking-wide">WHATSAPP</span>
            </a>

            <!-- Gmail -->
            <a
                href="mailto:isitvritra@gmail.com"
                class="flex items-center gap-2 text-black/70 hover:text-black transition-colors"
            >
                <img
                    src="/social-medias/gmail.png"
                    alt="Gmail"
                    class="w-5 h-5 object-contain"
                />
                <span class="font-medium tracking-wide">GMAIL</span>
            </a>

            <div class="hidden md:block flex-1 h-px bg-black/10"></div>
        </div>
    </div>
</section>
