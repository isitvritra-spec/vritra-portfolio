---
interface Props {
    currentProject: {
        name: string;
        client: string;
        phase: string;
        timeline: string;
        progress: number;
    };
}

const { currentProject } = Astro.props;
---

<section id="current-work" class="py-32 relative overflow-hidden bg-black">
    <!-- Animated Background Elements -->
    <div class="absolute inset-0 overflow-hidden">
        <!-- Gradient Orbs - Monochrome -->
        <div
            class="absolute top-20 left-10 w-72 h-72 bg-white/5 rounded-full blur-3xl animate-pulse"
        >
        </div>
        <div
            class="absolute bottom-20 right-10 w-96 h-96 bg-white/3 rounded-full blur-3xl animate-pulse"
            style="animation-delay: 1s;"
        >
        </div>
        <div
            class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-white/5 rounded-full blur-3xl"
        >
        </div>

        <!-- Grid Pattern Overlay -->
        <div
            class="absolute inset-0 opacity-5"
            style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 40px 40px;"
        >
        </div>
    </div>

    <div class="max-w-7xl mx-auto px-6 relative z-10">
        <!-- Header -->
        <div class="text-center mb-16">
            <!-- Confidential Badge -->
            <div
                class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 border border-white/20 text-white/80 text-sm font-medium mb-6 backdrop-blur-sm"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                >
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"></path>
                    <path d="m9 12 2 2 4-4"></path>
                </svg>
                <span>FLAGSHIP PROJECT • CONFIDENTIAL</span>
            </div>

            <h2
                class="text-5xl md:text-7xl font-black text-white mb-4 tracking-tight"
            >
                FEATURED <span class="text-white/40">PROJECT</span>
            </h2>
            <p class="text-lg text-white/50 max-w-3xl mx-auto leading-relaxed">
                Currently building next-generation health intelligence
                infrastructure for a <span class="text-white font-semibold"
                    >United Nations Agency</span
                >. This AI-powered platform is designed to process real-time
                data and deliver LLM-driven insights for international health
                preparedness.
            </p>
        </div>

        <!-- Main Project Card -->
        <div class="relative group">
            <!-- Glow Effect Behind Card - Monochrome -->
            <div
                class="absolute -inset-1 bg-gradient-to-r from-white/20 via-white/10 to-white/20 rounded-3xl blur-xl opacity-30 group-hover:opacity-50 transition-opacity duration-500"
            >
            </div>

            <!-- Glass Card -->
            <div
                class="relative bg-white/5 backdrop-blur-xl border border-white/10 rounded-3xl overflow-hidden"
            >
                <!-- Top Accent Bar - White gradient -->
                <div
                    class="h-1 bg-gradient-to-r from-white/20 via-white/60 to-white/20"
                >
                </div>

                <div class="p-8 md:p-12">
                    <div class="grid lg:grid-cols-2 gap-12 items-center">
                        <!-- Left Column - Project Info -->
                        <div class="space-y-8">
                            <!-- Project Title -->
                            <div>
                                <div class="flex items-center gap-3 mb-4">
                                    <div
                                        class="w-3 h-3 rounded-full bg-green-500 animate-pulse"
                                    >
                                    </div>
                                    <span
                                        class="text-green-400 text-sm font-semibold uppercase tracking-wider"
                                        >Active Development</span
                                    >
                                </div>
                                <h3
                                    class="text-4xl md:text-5xl font-bold text-white mb-3 leading-tight"
                                >
                                    {currentProject.name}
                                </h3>
                                <p
                                    class="text-xl text-white/50 flex items-center gap-2"
                                >
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        width="20"
                                        height="20"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        class="text-white/60"
                                    >
                                        <path
                                            d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0-18 0"
                                        ></path>
                                        <path d="M12 2v4"></path>
                                        <path d="M12 18v4"></path>
                                        <path d="m4.93 4.93 2.83 2.83"></path>
                                        <path d="m16.24 16.24 2.83 2.83"></path>
                                        <path d="M2 12h4"></path>
                                        <path d="M18 12h4"></path>
                                        <path d="m4.93 19.07 2.83-2.83"></path>
                                        <path d="m16.24 7.76 2.83-2.83"></path>
                                    </svg>
                                    {currentProject.client}
                                </p>
                            </div>

                            <!-- Key Highlights -->
                            <div class="space-y-4">
                                <div class="flex items-start gap-4">
                                    <div
                                        class="w-10 h-10 rounded-xl bg-white/10 flex items-center justify-center flex-shrink-0"
                                    >
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            width="20"
                                            height="20"
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="2"
                                            class="text-white"
                                        >
                                            <path d="M12 8V4H8"></path><rect
                                                width="16"
                                                height="12"
                                                x="4"
                                                y="8"
                                                rx="2"></rect><path d="M2 14h2"
                                            ></path><path d="M20 14h2"
                                            ></path><path d="M15 13v2"
                                            ></path><path d="M9 13v2"></path>
                                        </svg>
                                    </div>
                                    <div>
                                        <h4
                                            class="text-white font-semibold mb-1"
                                        >
                                            AI-Powered Intelligence
                                        </h4>
                                        <p class="text-white/40 text-sm">
                                            RAG-based LLM integration with Azure
                                            OpenAI for intelligent data analysis
                                        </p>
                                    </div>
                                </div>
                                <div class="flex items-start gap-4">
                                    <div
                                        class="w-10 h-10 rounded-xl bg-white/10 flex items-center justify-center flex-shrink-0"
                                    >
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            width="20"
                                            height="20"
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="2"
                                            class="text-white"
                                        >
                                            <path
                                                d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"
                                            ></path>
                                        </svg>
                                    </div>
                                    <div>
                                        <h4
                                            class="text-white font-semibold mb-1"
                                        >
                                            Enterprise Security
                                        </h4>
                                        <p class="text-white/40 text-sm">
                                            Government-grade security protocols
                                            with end-to-end encryption
                                        </p>
                                    </div>
                                </div>
                                <div class="flex items-start gap-4">
                                    <div
                                        class="w-10 h-10 rounded-xl bg-white/10 flex items-center justify-center flex-shrink-0"
                                    >
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            width="20"
                                            height="20"
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="2"
                                            class="text-white"
                                        >
                                            <path d="M3 3v18h18"></path><path
                                                d="m19 9-5 5-4-4-3 3"></path>
                                        </svg>
                                    </div>
                                    <div>
                                        <h4
                                            class="text-white font-semibold mb-1"
                                        >
                                            Real-Time Processing
                                        </h4>
                                        <p class="text-white/40 text-sm">
                                            Processing millions of health data
                                            points with sub-second latency
                                        </p>
                                    </div>
                                </div>
                            </div>

                            <!-- Tech Stack -->
                            <div>
                                <p
                                    class="text-xs text-white/30 uppercase tracking-widest mb-3"
                                >
                                    Technology Stack
                                </p>
                                <div class="flex flex-wrap gap-2">
                                    <span
                                        class="px-4 py-2 bg-white/10 backdrop-blur-sm rounded-full text-sm font-medium text-white border border-white/10 hover:bg-white/20 hover:border-white/30 transition-all cursor-default"
                                        >Python</span
                                    >
                                    <span
                                        class="px-4 py-2 bg-white/10 backdrop-blur-sm rounded-full text-sm font-medium text-white border border-white/10 hover:bg-white/20 hover:border-white/30 transition-all cursor-default"
                                        >Django</span
                                    >
                                    <span
                                        class="px-4 py-2 bg-white/10 backdrop-blur-sm rounded-full text-sm font-medium text-white border border-white/10 hover:bg-white/20 hover:border-white/30 transition-all cursor-default"
                                        >React</span
                                    >
                                    <span
                                        class="px-4 py-2 bg-white/10 backdrop-blur-sm rounded-full text-sm font-medium text-white border border-white/10 hover:bg-white/20 hover:border-white/30 transition-all cursor-default"
                                        >RAG</span
                                    >
                                    <span
                                        class="px-4 py-2 bg-white/10 backdrop-blur-sm rounded-full text-sm font-medium text-white border border-white/10 hover:bg-white/20 hover:border-white/30 transition-all cursor-default"
                                        >Llama</span
                                    >
                                    <span
                                        class="px-4 py-2 bg-white/10 backdrop-blur-sm rounded-full text-sm font-medium text-white border border-white/10 hover:bg-white/20 hover:border-white/30 transition-all cursor-default"
                                        >PostgreSQL</span
                                    >
                                    <span
                                        class="px-4 py-2 bg-white/10 backdrop-blur-sm rounded-full text-sm font-medium text-white border border-white/10 hover:bg-white/20 hover:border-white/30 transition-all cursor-default"
                                        >Azure Services</span
                                    >
                                    <span
                                        class="px-4 py-2 bg-white/10 backdrop-blur-sm rounded-full text-sm font-medium text-white border border-white/10 hover:bg-white/20 hover:border-white/30 transition-all cursor-default"
                                        >Vector DB</span
                                    >
                                </div>
                            </div>
                        </div>

                        <!-- Right Column - Progress & Status -->
                        <div class="space-y-8">
                            <!-- Team Collaboration -->
                            <div
                                class="bg-white/5 rounded-2xl p-8 border border-white/10"
                            >
                                <p
                                    class="text-xs text-white/30 uppercase tracking-widest mb-6 text-center"
                                >
                                    Project Team
                                </p>

                                <!-- Profile Images Row with Single Line -->
                                <div class="flex items-center justify-center">
                                    <!-- Your Profile Image -->
                                    <div
                                        class="w-20 h-20 rounded-full overflow-hidden border-2 border-white/20 flex-shrink-0"
                                    >
                                        <img
                                            src="/profile.png"
                                            alt="Vritra"
                                            class="w-full h-full object-cover"
                                        />
                                    </div>

                                    <!-- Single Continuous Line -->
                                    <div
                                        class="w-20 h-[2px] bg-white/20 relative overflow-hidden mx-2"
                                    >
                                        <div
                                            class="absolute top-0 left-0 w-6 h-full bg-gradient-to-r from-transparent via-white to-transparent animate-flow-right"
                                        >
                                        </div>
                                    </div>

                                    <!-- Colleague Profile Image -->
                                    <div
                                        class="w-20 h-20 rounded-full overflow-hidden border-2 border-white/20 flex-shrink-0"
                                    >
                                        <img
                                            src="/clients/collegue.png"
                                            alt="Isaias Co"
                                            class="w-full h-full object-cover"
                                        />
                                    </div>
                                </div>

                                <!-- Names Row -->
                                <div class="flex justify-center gap-16 mt-4">
                                    <div class="text-center">
                                        <p
                                            class="text-white text-sm font-medium"
                                        >
                                            Vritra
                                        </p>
                                        <p class="text-white/40 text-xs">
                                            AI Solutions Architect
                                        </p>
                                    </div>
                                    <div class="text-center">
                                        <p
                                            class="text-white text-sm font-medium"
                                        >
                                            Isaias Co
                                        </p>
                                        <p class="text-white/40 text-xs">
                                            Epidemiologist & ML/AI
                                        </p>
                                    </div>
                                </div>
                            </div>

                            <!-- Progress Visualization -->
                            <div
                                class="bg-white/5 rounded-2xl p-6 border border-white/10"
                            >
                                <div class="flex items-center justify-between">
                                    <div>
                                        <p
                                            class="text-xs text-white/30 uppercase tracking-widest mb-2"
                                        >
                                            Current Phase
                                        </p>
                                        <p
                                            class="text-xl font-bold text-white mb-1"
                                        >
                                            {currentProject.phase}
                                        </p>
                                        <p class="text-white/50 text-sm">
                                            {currentProject.timeline}
                                        </p>
                                    </div>
                                    <div class="relative">
                                        <svg
                                            class="w-24 h-24 -rotate-90"
                                            viewBox="0 0 100 100"
                                        >
                                            <circle
                                                cx="50"
                                                cy="50"
                                                r="42"
                                                fill="none"
                                                stroke="white"
                                                stroke-opacity="0.1"
                                                stroke-width="8"></circle>
                                            <circle
                                                cx="50"
                                                cy="50"
                                                r="42"
                                                fill="none"
                                                stroke="white"
                                                stroke-width="8"
                                                stroke-linecap="round"
                                                stroke-dasharray="264"
                                                stroke-dashoffset={264 -
                                                    (264 *
                                                        currentProject.progress) /
                                                        100}
                                                class="transition-all duration-1000"
                                            ></circle>
                                        </svg>
                                        <div
                                            class="absolute inset-0 flex flex-col items-center justify-center"
                                        >
                                            <span
                                                class="text-2xl font-bold text-white"
                                                >{
                                                    currentProject.progress
                                                }%</span
                                            >
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Confidentiality Notice -->
                            <div
                                class="flex items-center gap-3 p-4 rounded-xl bg-white/5 border border-white/10"
                            >
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="20"
                                    height="20"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    class="text-white/60 flex-shrink-0"
                                >
                                    <path d="M12 9v4"></path>
                                    <path
                                        d="M10.363 3.591l-8.106 13.534a1.914 1.914 0 0 0 1.636 2.871h16.214a1.914 1.914 0 0 0 1.636-2.87L13.637 3.59a1.914 1.914 0 0 0-3.274 0z"
                                    ></path>
                                    <path d="M12 17h.01"></path>
                                </svg>
                                <p class="text-white/50 text-sm">
                                    Due to NDA, detailed project information is
                                    confidential. Available for discussion in
                                    private consultations.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Government Work CTA -->
        <div class="text-center mt-16">
            <p class="text-white/30 text-sm uppercase tracking-widest mb-4">
                Interested in similar solutions?
            </p>
            <a
                href="/contact"
                class="group inline-flex items-center gap-3 px-8 py-4 bg-white text-black font-semibold rounded-full hover:bg-white/90 hover:shadow-lg hover:shadow-white/10 transition-all hover:-translate-y-1"
            >
                <span>Discuss Your Government Project</span>
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    class="group-hover:translate-x-1 transition-transform"
                >
                    <path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path>
                </svg>
            </a>
        </div>
    </div>
</section>
